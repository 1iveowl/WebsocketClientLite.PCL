{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Close requirements v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "boundary_seeds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assumption": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "review_anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "assumption",
          "review_anchor"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CLOSE-[0-9]{3}$"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "origin": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "contracts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "clauses": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "required": [
                "file",
                "symbol",
                "clauses"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "production_paths": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "reference": {
                  "type": "object",
                  "properties": {
                    "file": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "symbol": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "file",
                    "symbol"
                  ],
                  "additionalProperties": false
                },
                "responsibility": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "reference",
                "responsibility"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "obligations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "kind": {
                  "enum": [
                    "proof",
                    "test",
                    "mutation",
                    "review"
                  ]
                },
                "delivery": {
                  "enum": [
                    "existing",
                    "B",
                    "C",
                    "E"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "symbol": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "file",
                      "symbol"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 0,
                  "uniqueItems": true
                }
              },
              "required": [
                "id",
                "kind",
                "delivery",
                "description",
                "references"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "intent",
          "origin",
          "contracts",
          "production_paths",
          "assumptions",
          "obligations",
          "exclusions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "boundary_seeds",
    "requirements"
  ],
  "additionalProperties": false
}
