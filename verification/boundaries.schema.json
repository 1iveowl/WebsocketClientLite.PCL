{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Close boundaries v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "boundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assumption": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "review_anchor": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "owners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "symbol": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "file",
                "symbol"
              ],
              "additionalProperties": false
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "test_obligations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "assumption",
          "review_anchor",
          "owners",
          "requirements",
          "test_obligations",
          "exclusions"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "boundaries"
  ],
  "additionalProperties": false
}
